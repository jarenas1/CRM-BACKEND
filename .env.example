# =================================================================
# V Grand Hotel CRM — Backend Environment
# Copia este archivo a `.env` y completa los valores reales
# =================================================================

# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=cambia-esta-clave-super-secreta-en-produccion
JWT_EXPIRES_IN=8h

# Base de datos NeonDB (PostgreSQL)
# Pega aquí la cadena de conexión que te da Neon en el panel:
# Ejemplo: postgresql://usuario:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Admin inicial (se crea al ejecutar el seeder)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=VGrand2026*
ADMIN_NAME=Andrés Felipe Arenas Restrepo
ADMIN_EMAIL=arenas.pipe@hotmail.com
ADMIN_CARGO=Director de Trade Marketing

# ───────── SMTP (Gmail) ─────────
# Envío vía Gmail:
#   - SMTP_HOST   = smtp.gmail.com
#   - SMTP_PORT   = 465  (SSL directo)  ·  usa 587 para STARTTLS
#   - SMTP_SECURE = true en 465  ·  false en 587  (opcional: se deduce del puerto)
# IMPORTANTE: SMTP_PASS debe ser una "App Password" de 16 caracteres (sin espacios),
# NO la contraseña normal de la cuenta. Requiere verificación en 2 pasos activada.
# Genera la App Password en: https://myaccount.google.com/apppasswords
# SMTP_USER y SMTP_FROM deben ser la MISMA dirección de Gmail autenticada.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password-de-16-caracteres
SMTP_FROM=tu-correo@gmail.com
SMTP_FROM_NAME=V Grand Hotel Medellín
SMTP_REPLY_TO=reservas@v-grandhotels.com
EMAIL_CC_FIJO=juanjoarenas1218@gmail.com

# ───────── Proveedor de correo ─────────
# 'smtp'  → usa Gmail SMTP (ideal en local).
# 'brevo' → usa la API HTTP de Brevo (OBLIGATORIO en Render y hosts que
#           bloquean el SMTP saliente; de lo contrario los correos dan "Connection timeout").
EMAIL_PROVIDER=smtp
# API key de Brevo (Brevo → SMTP & API → API Keys). Requerida si EMAIL_PROVIDER=brevo.
BREVO_API_KEY=
# En Brevo verifica el remitente (SMTP_FROM) en: Senders, Domains & Dedicated IPs → Senders.
# El envío usa SMTP_FROM / SMTP_FROM_NAME / SMTP_REPLY_TO definidos arriba.

# URL pública del backend (sin barra final). En producción (Brevo) los logos de los
# correos se sirven desde aquí (/brand/...). Debe ser la URL del backend en Render.
PUBLIC_BASE_URL=

# Hotel / Empresa
HOTEL_RAZON_SOCIAL=Hacer y Servis SAS
HOTEL_NIT=901166587
HOTEL_DIRECCION=Cra. 43A # 14-81, El Poblado, Medellín, Antioquia, Colombia
HOTEL_WEB=https://www.v-grandhotels.com/es
HOTEL_EMAIL_VENTAS=trademarketing@v-grandhotels.com
HOTEL_EMAIL_RESERVAS=reservas@v-grandhotels.com
HOTEL_WHATSAPP=+57 311 876 83 25
HOTEL_LINK_PAGO=https://checkout.wompi.co/l/VPOS_0DIY66
